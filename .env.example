# ---------------------------------------------------------------------------
# Afghan IT Academy — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable below is validated at API startup by apps/api/src/config; the
# process refuses to boot rather than run half-configured.
# ---------------------------------------------------------------------------

# --- Local infrastructure (docker-compose) ---------------------------------
POSTGRES_USER=aia
POSTGRES_PASSWORD=aia_dev_password
POSTGRES_DB=afghan_it_academy

# --- API -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api
LOG_LEVEL=debug

DATABASE_URL=postgresql://aia:aia_dev_password@localhost:5432/afghan_it_academy?schema=public
REDIS_URL=redis://localhost:6379

# Comma-separated exact origins. No wildcards: the API sends credentials.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Reverse-proxy hops to trust for client IP resolution. 0 when running directly.
# Set to the real hop count in production, never higher — each trusted hop is a
# header an attacker may be able to forge.
TRUSTED_PROXY_HOPS=0

BODY_LIMIT_BYTES=1048576

# --- Authentication --------------------------------------------------------
# Argon2id. The schema enforces the OWASP baseline as a floor and refuses to
# start below it, so lowering these to speed up a slow machine is not possible.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# Token lifetimes, in seconds. These must nest: access < refresh <= session.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=7776000

AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600

# Cookie Domain attribute. Leave unset locally so cookies scope to the host.
# AUTH_COOKIE_DOMAIN=.afghanitacademy.af

# Where the web app lives. Verification and reset links are built from this, so
# it is configuration and never a request header.
WEB_APP_URL=http://localhost:3000

# --- Web -------------------------------------------------------------------
# Public: inlined into the browser bundle. Never put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
